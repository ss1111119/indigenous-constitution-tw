# 相依套件
node_modules/
dist/
.vite/

# 發佈組建產物。由 scripts/build-site.py 從 site/ 與 data/ 組出，
# 隨時可重建，且入庫會讓產物與原始碼有機會不同步。
_site/

# 作業系統與編輯器
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# data/raw 的入庫判準
#
#   可重新取得者 → 不入庫。
#   不可重新取得者 → 入庫，並在下面以例外標明，附上「為什麼這一份不適用」的理由。
#
# 判準是「能不能重新取得」，不是副檔名。下面的規則按副檔名寫只是實作手段——
# 而那個手段曾經漏掉一整類檔案：ODRP018 的 40MB JSON 因為清單裡沒有 .json
# 而被入庫，不是有人衡量後的決定。新增一種來源格式時，先問判準，再加規則。
#
# 不入庫的代價是可稽核性，那由 data/sources.json 的 sha256 欄位補上：
# 任何人重新取得、比對雜湊、確認與本專案用的是同一份資料，再重跑轉檔腳本。
# ODRP 兩份可用 scripts/fetch-raw.py 取回（該 API 分頁，必須逐頁合併）。
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.zip
data/raw/**/*.shp
data/raw/**/*.dbf
data/raw/**/*.shx
data/raw/**/*.prj
data/raw/**/*.gpkg
data/raw/**/*.json

# 例外：無法重新下載者仍須入庫，否則驗算結果無從稽核。
# 戶政司這份的下載連結由 JS 產生，頁面上沒有 <a href>，curl 直取不到，
# 必須人工開瀏覽器點擊，因此上面那條規則的前提不成立。
!data/raw/moi-year-end-population-by-sex-age.xls

# 例外：原民會人口月報（民國115年6月，2026-06）。共約 4MB。
# 這一期是「第 17 族出現前的最後一期乾淨快照」——西拉雅族自 2026-08 中開放身分登記，
# 之後所有月報都會是 17 族結構，這個 16 族的基準狀態無法回溯重建。
# 而原民會月報頁是否保留歷史期數「待確認」（見 feasibility-study.md 待辦 5），
# 也就是說「原始檔可重新下載」這個前提在此無法成立。
# 風險不對稱：4MB 的儲存成本 vs 不可回復的稽核基準遺失，因此入庫。
# 若日後確認原民會確實保留歷史期數，可回頭收掉這條例外。
!data/raw/cip-11506-*.xls

# 暫存
*.log
*.tmp
.spectra/
openspec/.vector-search.db*
